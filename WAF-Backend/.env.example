# Database Configuration
# Pour déploiement sur PC (sans Docker) : utilise localhost
# Pour Docker : utilise le nom du service (postgres)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wafap
DB_USER=wafap_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Security
# Génère un JWT secret avec : openssl rand -base64 64
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_64
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# CORS Configuration
# Comma-separated list of allowed origins for CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Spring Profile
# dev = H2 database, prod = PostgreSQL
SPRING_PROFILES_ACTIVE=prod
